# Production Environment Configuration
# Copy this file to .env and update the values for your production deployment

# ------------------------------
# SECURITY - CHANGE THESE VALUES!
# ------------------------------
# Generate a strong secret key with: openssl rand -base64 42
SECRET_KEY=CHANGE_THIS_TO_YOUR_SECRET_KEY

# Database passwords
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# API Keys for services
SANDBOX_API_KEY=CHANGE_THIS_TO_STRONG_API_KEY
PLUGIN_DAEMON_KEY=CHANGE_THIS_TO_STRONG_API_KEY
PLUGIN_DIFY_INNER_API_KEY=CHANGE_THIS_TO_STRONG_API_KEY
WEAVIATE_API_KEY=CHANGE_THIS_TO_STRONG_API_KEY

# ------------------------------
# Service URLs Configuration
# ------------------------------
# Set these to your actual domain/URLs
CONSOLE_API_URL=https://api.yourdomain.com
CONSOLE_WEB_URL=https://console.yourdomain.com
SERVICE_API_URL=https://api.yourdomain.com
APP_API_URL=https://api.yourdomain.com
APP_WEB_URL=https://app.yourdomain.com
FILES_URL=https://files.yourdomain.com

# ------------------------------
# Database Configuration
# ------------------------------
DB_USERNAME=postgres
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin

# PostgreSQL Performance Tuning
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=8GB

# ------------------------------
# Redis Configuration
# ------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------
# Application Configuration
# ------------------------------
DEPLOY_ENV=PRODUCTION
LOG_LEVEL=INFO
DEBUG=false
FLASK_DEBUG=false

# Worker configuration
SERVER_WORKER_AMOUNT=4
CELERY_WORKER_AMOUNT=2
CELERY_AUTO_SCALE=true
CELERY_MAX_WORKERS=8
CELERY_MIN_WORKERS=2

# ------------------------------
# Vector Store Configuration
# ------------------------------
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080

# ------------------------------
# SSL/HTTPS Configuration
# ------------------------------
NGINX_HTTPS_ENABLED=true
NGINX_SERVER_NAME=yourdomain.com
NGINX_SSL_CERT_FILENAME=yourdomain.crt
NGINX_SSL_CERT_KEY_FILENAME=yourdomain.key
NGINX_SSL_PROTOCOLS=TLSv1.2 TLSv1.3

# Let's Encrypt Configuration (if using Certbot)
CERTBOT_EMAIL=admin@yourdomain.com
CERTBOT_DOMAIN=yourdomain.com

# ------------------------------
# Performance Configuration
# ------------------------------
SQLALCHEMY_POOL_SIZE=50
SQLALCHEMY_POOL_RECYCLE=3600
GUNICORN_TIMEOUT=360
APP_MAX_EXECUTION_TIME=1200
WORKFLOW_MAX_EXECUTION_TIME=1200

# ------------------------------
# File Upload Limits
# ------------------------------
UPLOAD_FILE_SIZE_LIMIT=50
UPLOAD_FILE_BATCH_LIMIT=10
UPLOAD_IMAGE_FILE_SIZE_LIMIT=20
UPLOAD_VIDEO_FILE_SIZE_LIMIT=200
UPLOAD_AUDIO_FILE_SIZE_LIMIT=100

# ------------------------------
# Monitoring (Optional)
# ------------------------------
API_SENTRY_DSN=
WEB_SENTRY_DSN=
ENABLE_OTEL=false

# ------------------------------
# Email Configuration (Optional)
# ------------------------------
MAIL_TYPE=smtp
SMTP_SERVER=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_DEFAULT_SEND_FROM=noreply@yourdomain.com

# ------------------------------
# Port Exposure
# ------------------------------
EXPOSE_NGINX_PORT=80
EXPOSE_NGINX_SSL_PORT=443
EXPOSE_PLUGIN_DEBUGGING_PORT=5003

# ------------------------------
# Marketplace Configuration
# ------------------------------
MARKETPLACE_ENABLED=true
MARKETPLACE_API_URL=https://marketplace.devagentic.io
CHECK_UPDATE_URL=https://updates.devagentic.io